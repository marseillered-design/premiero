# TMDB: API Read Access Token or v3 API key - https://www.themoviedb.org/settings/api
TMDB_TOKEN=
# OMDb (IMDb ratings), free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Игры: приложение на https://dev.twitch.tv/console/apps (IGDB принадлежит Twitch)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Вход через Google: https://console.cloud.google.com/auth/clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Любая длинная случайная строка для подписи куки сессии
AUTH_SECRET=
# Аккаунты: Upstash Redis (Vercel → Storage), ключи REST API
KV_REST_API_URL=
KV_REST_API_TOKEN=
