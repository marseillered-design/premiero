// thepremiero.com on Cloudflare: edge-worker.js in front of the Next.js server on Google Cloud Run.
// Deploy: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "premiero",
  "main": "edge-worker.js",
  "compatibility_date": "2026-09-01",
  // the Next.js server (Google Cloud Run)
  "vars": {
    "ORIGIN": "https://premiero-832444804335.us-central1.run.app"
  },
  // the cron jobs of vercel.json, in UTC; they call the server with CRON_SECRET (a Worker secret)
  "triggers": { "crons": ["0 4 * * *", "0 7 * * *"] },
  // no *.workers.dev address: it would skip the Cloudflare bot rules of the thepremiero.com zone
  "workers_dev": false,
  "routes": [
    { "pattern": "thepremiero.com", "custom_domain": true },
    { "pattern": "www.thepremiero.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
